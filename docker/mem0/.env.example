# With the ollama stack any non-empty value works here.
OPENAI_API_KEY=ollama
ANTHROPIC_API_KEY=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

JWT_SECRET=
ADMIN_API_KEY=
AUTH_DISABLED=false
APP_DB_NAME=mem0_app
DASHBOARD_URL=http://192.168.1.84:3001

MEM0_TELEMETRY=false

# Models are served by the ollama stack through its OpenAI-compatible API.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
MEM0_DEFAULT_LLM_MODEL=qwen2.5:3b
MEM0_DEFAULT_EMBEDDER_MODEL=nomic-embed-text
