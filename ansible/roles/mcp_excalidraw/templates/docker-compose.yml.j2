# roles/mcp_excalidraw/templates/docker-compose.yml.j2
services:
  canvas:
    image: ghcr.io/yctimlin/mcp_excalidraw-canvas:latest
    container_name: mcp-excalidraw-canvas
    restart: unless-stopped
    ports:
      - "{{ mcp_excalidraw_bind_addr }}:{{ mcp_excalidraw_canvas_port }}:3000"
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://127.0.0.1:3000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
