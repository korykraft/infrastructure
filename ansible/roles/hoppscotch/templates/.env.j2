# Database
DATABASE_URL=postgresql://hoppscotch:{{ hoppscotch_db_password }}@postgres:5432/hoppscotch

# Encryption (32-char hex)
DATA_ENCRYPTION_KEY={{ hoppscotch_encryption_key }}

# Subpath-based access (required for AIO container)
ENABLE_SUBPATH_BASED_ACCESS=true

# Whitelisted origins
WHITELISTED_ORIGINS=http://localhost:3170,http://localhost:3000,http://localhost:3100,app://localhost_3200,app://hoppscotch

# Frontend config
VITE_BASE_URL=http://{{ ansible_default_ipv4.address }}:{{ hoppscotch_port }}
VITE_SHORTCODE_BASE_URL=http://{{ ansible_default_ipv4.address }}:{{ hoppscotch_port }}
VITE_ADMIN_URL=http://{{ ansible_default_ipv4.address }}:{{ hoppscotch_port }}/admin

# Backend URLs
VITE_BACKEND_GQL_URL=http://{{ ansible_default_ipv4.address }}:{{ hoppscotch_port }}/backend/graphql
VITE_BACKEND_WS_URL=ws://{{ ansible_default_ipv4.address }}:{{ hoppscotch_port }}/backend/graphql
VITE_BACKEND_API_URL=http://{{ ansible_default_ipv4.address }}:{{ hoppscotch_port }}/backend/v1

# Terms / Privacy
VITE_APP_TOS_LINK=https://docs.hoppscotch.io/support/terms
VITE_APP_PRIVACY_POLICY_LINK=https://docs.hoppscotch.io/support/privacy
