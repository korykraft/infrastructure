NEXT_PUBLIC_BASE_URL={{ kan_base_url }}
BETTER_AUTH_SECRET={{ kan_better_auth_secret }}
POSTGRES_PASSWORD={{ kan_postgres_password }}
POSTGRES_URL=postgresql://kan:{{ kan_postgres_password }}@postgres:5432/kan_db
# Enables email + password login; without it Kan has no sign-in method unless OAuth/OIDC is configured.
NEXT_PUBLIC_ALLOW_CREDENTIALS=true
# No SMTP configured: turn email features off.
NEXT_PUBLIC_DISABLE_EMAIL=true
