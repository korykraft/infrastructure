# With the ollama stack any non-empty value works here.
OPENAI_API_KEY={{ mem0_openai_api_key | default('ollama', true) }}
OPENAI_BASE_URL={{ mem0_openai_base_url }}
MEM0_DEFAULT_LLM_MODEL={{ mem0_llm_model }}
MEM0_DEFAULT_EMBEDDER_MODEL={{ mem0_embedder_model }}
ANTHROPIC_API_KEY={{ mem0_anthropic_api_key }}

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER={{ mem0_postgres_user }}
POSTGRES_PASSWORD={{ mem0_postgres_password }}
POSTGRES_COLLECTION_NAME=memories

JWT_SECRET={{ mem0_jwt_secret }}
ADMIN_API_KEY={{ mem0_admin_api_key }}
AUTH_DISABLED=false
APP_DB_NAME=mem0_app
DASHBOARD_URL=http://{{ ansible_default_ipv4.address }}:{{ mem0_dashboard_port }}

MEM0_TELEMETRY={{ mem0_telemetry }}
